+    const auto lost = one_track(missing, "T50");
+    require(lost.state_ == TrackState::Lost && lost.track_id_ == id &&
+            !lost.position_m_ && !lost.velocity_mps_ && !lost.qualified_for_g5_,
+            "T50 真正缺测进入预测后仍必须按同一位置误差预算LOST，不能一概关闭门控");
